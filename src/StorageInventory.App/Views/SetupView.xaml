<UserControl x:Class="StorageInventory.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StorageInventory.App.ViewModels">
    <!-- v1 MainWindow.xaml lines 25-167 (the Setup stage), unchanged apart from indentation. Bound to the Scan page's view model. -->
    <StackPanel>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Label Style="{StaticResource FieldLabel}" Content="_Folder or drive to scan" Target="{Binding ElementName=SourceBox}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceBox" Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Folder or drive to scan"
                             AutomationProperties.HelpText="For example D:\ or D:\Media" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Bro_wse…" MinWidth="96"
                            Command="{Binding BrowseSourceCommand}"
                            AutomationProperties.Name="Browse for the folder or drive to scan" />
                </Grid>

                <Label Style="{StaticResource FieldLabel}" Content="_Save reports to" Target="{Binding ElementName=OutputBox}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputBox" Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Folder to save the reports in"
                             AutomationProperties.HelpText="Must be outside the folder being scanned" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="B_rowse…" MinWidth="96"
                            Command="{Binding BrowseOutputCommand}"
                            AutomationProperties.Name="Browse for the folder to save the reports in" />
                </Grid>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" FontSize="12"
                           Text="Reports are always new files. Nothing that already exists is ever overwritten." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Options" />
                <CheckBox IsChecked="{Binding SortFiles}" Content="S_ort individual files largest-first"
                          AutomationProperties.HelpText="Uses extra memory and temporary disk space in the report folder while the report is written." />
                <TextBlock Style="{StaticResource Secondary}" Margin="28,2,0,12" FontSize="12"
                           Text="Uses a little extra memory and temporary disk space in the report folder while the Files report is written." />
                <CheckBox IsChecked="{Binding CreateWorkbook}" Content="Also create an _Excel workbook (.xlsx)"
                          AutomationProperties.HelpText="Optional convenience copy made after the scan. The CSV reports remain the complete result." />
                <TextBlock Style="{StaticResource Secondary}" Margin="28,2,0,0" FontSize="12"
                           Text="Optional convenience copy made after the scan. Excel does not need to be installed. The CSV reports remain the complete, authoritative result." />
            </StackPanel>
        </Border>

        <!-- Pre-flight: presents Core's validation; makes no decisions of its own -->
        <Border Style="{StaticResource Card}" DataContext="{Binding Preflight}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center"
                               Text="{Binding StatusGlyph}" AutomationProperties.Name="{Binding StatusLabel}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:PreflightState.Ready}">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:PreflightState.Warning}">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:PreflightState.Blocked}">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="{Binding StatusLabel}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,14" Text="{Binding Headline}"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Headline}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FactName}" Text="Source" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding SourceSummary}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FactName}" Text="Reports" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding ReportsSummary}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FactName}" Text="File contents" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding FileContentsSummary}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FactName}" Text="Links" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding LinksSummary}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource FactName}" Text="Administrator" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding AdministratorSummary}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource FactName}" Text="Network" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding NetworkSummary}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0" Focusable="False"
                              AutomationProperties.Name="Pre-flight findings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,10,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                   AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="24,2,0,0" />
                                    <Expander Header="{Binding DetailsHeader}" Margin="20,4,0,0" HorizontalAlignment="Left" MinWidth="240"
                                              Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Technical details">
                                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                 Background="Transparent" FontFamily="Consolas" FontSize="12" Margin="4,4,0,0"
                                                 AutomationProperties.Name="Technical details" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Button HorizontalAlignment="Right" MinWidth="160" Padding="20,8" IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}"
                Command="{Binding StartScanCommand}"
                AutomationProperties.Name="Start scan"
                AutomationProperties.HelpText="Available when the pre-flight check is ready">
            <!-- Explicit AccessText: the accent button template does not process access keys itself. -->
            <AccessText Text="_Start scan" />
        </Button>
    </StackPanel>
</UserControl>
