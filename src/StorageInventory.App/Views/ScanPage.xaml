<UserControl x:Class="StorageInventory.App.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:StorageInventory.App.Views">
    <!-- The Scan page: v1 MainWindow.xaml's content (lines 10-387) with its three stages split into views. Bound to
         the Scan page's view model; the scan itself belongs to the app-lifetime ScanSession. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="32,24,32,32" MaxWidth="820">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Storage Inventory" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                           Text="See what is using space on a drive or folder. Read-only: your files are never opened, changed, moved or deleted." />
            </StackPanel>

            <!-- ============================== SETUP ============================== -->
            <views:SetupView Grid.Row="1" Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}" />
            <!-- ============================== SCANNING ============================== -->
            <views:ScanProgressView Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

            <!-- ============================== RESULTS ============================== -->
            <views:ResultsView Grid.Row="1" Visibility="{Binding IsResults, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </ScrollViewer>
</UserControl>
