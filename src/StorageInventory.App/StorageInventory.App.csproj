<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF application: a client of StorageInventory.Core. It contains no scanning or path-safety logic. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>StorageInventory.App</RootNamespace>
    <AssemblyName>StorageInventory</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>StorageInventory</AssemblyTitle>
    <Description>Read-only storage inventory for Windows.</Description>
    <!-- WPF's Fluent theme (ThemeMode) is marked experimental in the SDK. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StorageInventory.Core\StorageInventory.Core.csproj" />
    <!-- BLD-01: the App receives the Library's RUNTIME assets (the SQLite managed assemblies and e_sqlite3.dll, which the single-file
         publish bundles and extracts), but no compile-time access to SQLite: the Library's package references are
         PrivateAssets="compile" (A-12). C4 wires nothing to the Library yet; that is C5. -->
    <ProjectReference Include="..\StorageInventory.Library\StorageInventory.Library.csproj" />
  </ItemGroup>

  <!-- Self-contained publish: DisableTransitiveFrameworkReferenceDownloads (Directory.Build.props) stops the SDK from
       pre-fetching runtime packs for frameworks we don't use, but it also treats WPF's runtime pack as transitive, so an
       empty package cache would never receive it. Request exactly that one approved pack, at the SDK's bundled version. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true'">
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Runtime.win-x64" Version="[$(BundledNETCoreAppPackageVersion)]" />
  </ItemGroup>

</Project>
