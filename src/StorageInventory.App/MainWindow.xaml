<Window x:Class="StorageInventory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageInventory.App.ViewModels"
        xmlns:views="clr-namespace:StorageInventory.App.Views"
        Title="StorageInventory"
        Width="1080" Height="820" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="StorageInventory">

    <Window.Resources>
        <!-- One view per page: a page's view model is shown through its page view. -->
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:ScanPage />
        </DataTemplate>
    </Window.Resources>

    <!-- The shell: the navigation list and the page it shows. The navigation column is exactly as wide as the window
         is wider (and allowed to be narrower) than v1's, so the page keeps v1's size and layout. -->
    <Grid x:Name="ShellRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- No access key on the page names: v1's access keys keep working unchanged. -->
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox x:Name="NavigationList" Margin="8,24,8,8" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding Pages}" SelectedItem="{Binding Current}" DisplayMemberPath="Title"
                     AutomationProperties.Name="Pages" />
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding Current.ViewModel}" Focusable="False" IsTabStop="False" />
    </Grid>
</Window>
