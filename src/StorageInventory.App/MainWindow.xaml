<Window x:Class="StorageInventory.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StorageInventory.App.ViewModels"
        Title="StorageInventory"
        Width="880" Height="820" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="StorageInventory">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="32,24,32,32" MaxWidth="820">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Storage Inventory" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                           Text="See what is using space on a drive or folder. Read-only: your files are never opened, changed, moved or deleted." />
            </StackPanel>

            <!-- ============================== SETUP ============================== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Label Style="{StaticResource FieldLabel}" Content="_Folder or drive to scan" Target="{Binding ElementName=SourceBox}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceBox" Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Folder or drive to scan"
                                     AutomationProperties.HelpText="For example D:\ or D:\Media" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Bro_wse…" MinWidth="96"
                                    Command="{Binding BrowseSourceCommand}"
                                    AutomationProperties.Name="Browse for the folder or drive to scan" />
                        </Grid>

                        <Label Style="{StaticResource FieldLabel}" Content="_Save reports to" Target="{Binding ElementName=OutputBox}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Folder to save the reports in"
                                     AutomationProperties.HelpText="Must be outside the folder being scanned" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="B_rowse…" MinWidth="96"
                                    Command="{Binding BrowseOutputCommand}"
                                    AutomationProperties.Name="Browse for the folder to save the reports in" />
                        </Grid>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" FontSize="12"
                                   Text="Reports are always new files. Nothing that already exists is ever overwritten." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Options" />
                        <CheckBox IsChecked="{Binding SortFiles}" Content="S_ort individual files largest-first"
                                  AutomationProperties.HelpText="Uses extra memory and temporary disk space in the report folder while the report is written." />
                        <TextBlock Style="{StaticResource Secondary}" Margin="28,2,0,12" FontSize="12"
                                   Text="Uses a little extra memory and temporary disk space in the report folder while the Files report is written." />
                        <CheckBox IsChecked="{Binding CreateWorkbook}" Content="Also create an _Excel workbook (.xlsx)"
                                  AutomationProperties.HelpText="Optional convenience copy made after the scan. The CSV reports remain the complete result." />
                        <TextBlock Style="{StaticResource Secondary}" Margin="28,2,0,0" FontSize="12"
                                   Text="Optional convenience copy made after the scan. Excel does not need to be installed. The CSV reports remain the complete, authoritative result." />
                    </StackPanel>
                </Border>

                <!-- Pre-flight: presents Core's validation; makes no decisions of its own -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Preflight}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center"
                                       Text="{Binding StatusGlyph}" AutomationProperties.Name="{Binding StatusLabel}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:PreflightState.Ready}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:PreflightState.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:PreflightState.Blocked}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{Binding StatusLabel}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,14" Text="{Binding Headline}"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Headline}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FactName}" Text="Source" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding SourceSummary}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FactName}" Text="Reports" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding ReportsSummary}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FactName}" Text="File contents" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding FileContentsSummary}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FactName}" Text="Links" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding LinksSummary}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FactName}" Text="Administrator" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding AdministratorSummary}" />
                            <TextBlock Grid.Row="5" Style="{StaticResource FactName}" Text="Network" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding NetworkSummary}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0" Focusable="False"
                                      AutomationProperties.Name="Pre-flight findings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,10,0,6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                           AutomationProperties.Name="{Binding Label}" />
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="24,2,0,0" />
                                            <Expander Header="{Binding DetailsHeader}" Margin="20,4,0,0" HorizontalAlignment="Left" MinWidth="240"
                                                      Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="Technical details">
                                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                         Background="Transparent" FontFamily="Consolas" FontSize="12" Margin="4,4,0,0"
                                                         AutomationProperties.Name="Technical details" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button HorizontalAlignment="Right" MinWidth="160" Padding="20,8" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}"
                        Command="{Binding StartScanCommand}"
                        AutomationProperties.Name="Start scan"
                        AutomationProperties.HelpText="Available when the pre-flight check is ready">
                    <!-- Explicit AccessText: the accent button template does not process access keys itself. -->
                    <AccessText Text="_Start scan" />
                </Button>
            </StackPanel>
            <!-- ============================== SCANNING ============================== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" DataContext="{Binding}">
                <Border Style="{StaticResource Card}" DataContext="{Binding Progress}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Scanning" />
                        <TextBlock Text="{Binding Phase}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Phase}" />
                        <ProgressBar Height="6" Margin="0,0,0,18" IsIndeterminate="{Binding IsIndeterminate}" Value="{Binding PercentDone, Mode=OneWay}"
                                     AutomationProperties.Name="Scan progress"
                                     AutomationProperties.HelpText="Shows movement only; the total number of files is not known until the scan ends" />
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,16,14">
                                <TextBlock Style="{StaticResource FactName}" Text="Files found" />
                                <TextBlock Text="{Binding Files}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding Files, StringFormat='Files found: {0}'}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,14">
                                <TextBlock Style="{StaticResource FactName}" Text="Folders found" />
                                <TextBlock Text="{Binding Folders}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding Folders, StringFormat='Folders found: {0}'}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,14">
                                <TextBlock Style="{StaticResource FactName}" Text="Data found" />
                                <TextBlock Text="{Binding Data}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding Data, StringFormat='Data found: {0}'}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,14">
                                <TextBlock Style="{StaticResource FactName}" Text="Could not read" />
                                <TextBlock Text="{Binding Errors}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding Errors, StringFormat='Items that could not be read: {0}'}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,14">
                                <TextBlock Style="{StaticResource FactName}" Text="Links skipped" />
                                <TextBlock Text="{Binding LinksSkipped}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding LinksSkipped, StringFormat='Links skipped: {0}'}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,14">
                                <TextBlock Style="{StaticResource FactName}" Text="Elapsed" />
                                <TextBlock Text="{Binding Elapsed}" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="{Binding Elapsed, StringFormat='Elapsed: {0}'}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource FactName}" Text="Current folder" />
                        <TextBlock Text="{Binding CurrentFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFolder}" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Secondary}" Margin="2,0,2,16"
                           Text="Only names, sizes, dates and attributes are being read. Cancelling is safe: the report files are closed and clearly marked incomplete." />
                <Button HorizontalAlignment="Right" MinWidth="160" Padding="20,8" Command="{Binding CancelScanCommand}"
                        AutomationProperties.Name="Cancel scan">
                    <AccessText Text="_Cancel scan" />
                </Button>
            </StackPanel>

            <!-- ============================== RESULTS ============================== -->
            <StackPanel Grid.Row="1" Visibility="{Binding IsResults, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" DataContext="{Binding Results}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="20" VerticalAlignment="Center" Text="{Binding Glyph}"
                                       AutomationProperties.Name="{Binding Headline}" />
                            <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Headline}"
                                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Headline}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,14" Text="{Binding Explanation}" />
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="Counted before the scan stopped (partial, not totals):"
                                   Visibility="{Binding CountsArePartial, Converter={StaticResource BoolToVisibility}}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FactName}" Text="Files" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Files}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FactName}" Text="Folders" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Folders}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FactName}" Text="Total data" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding TotalData}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FactName}" Text="Could not read" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Errors}" />
                            <TextBlock Grid.Row="4" Style="{StaticResource FactName}" Text="Links skipped" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding LinksSkipped}" />
                            <TextBlock Grid.Row="5" Style="{StaticResource FactName}" Text="Elapsed" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Elapsed}" />
                            <TextBlock Grid.Row="6" Style="{StaticResource FactName}" Text="Completeness" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Completeness}" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,10,0,0" Text="{Binding WorkbookStatus}"
                                   Visibility="{Binding HasWorkbookStatus, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasIncompleteArtifacts, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="These files were created by this run but are INCOMPLETE. They are not valid reports and are safe to delete:" />
                            <ItemsControl ItemsSource="{Binding IncompleteArtifacts}" Margin="0,4,0,0" AutomationProperties.Name="Incomplete files">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Incomplete file" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button HorizontalAlignment="Right" MinWidth="160" Padding="20,8" Command="{Binding NewScanCommand}" AutomationProperties.Name="New scan">
                    <AccessText Text="_New scan" />
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
