<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core must never depend on WPF or any UI technology: the app is a client of this library. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>StorageInventory.Core</RootNamespace>
    <AssemblyName>StorageInventory.Core</AssemblyName>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <!-- A-13: the only assemblies that may see Core's internals (the observer, spool and identity layers are not public).
       From v1.1 C4 the list is exactly History, Library and the test projects: Core.Tests, History.Tests, Library.Tests and
       IntegrationTests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="StorageInventory.Core.Tests" />
    <InternalsVisibleTo Include="StorageInventory.History" />
    <InternalsVisibleTo Include="StorageInventory.History.Tests" />
    <InternalsVisibleTo Include="StorageInventory.Library" />
    <InternalsVisibleTo Include="StorageInventory.Library.Tests" />
    <InternalsVisibleTo Include="StorageInventory.IntegrationTests" />
  </ItemGroup>

</Project>
