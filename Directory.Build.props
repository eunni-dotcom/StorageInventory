<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Company>StorageInventory</Company>
    <Product>StorageInventory</Product>
    <Copyright>Copyright (c) 2026 eunni-dotcom</Copyright>
    <!-- Keep the binaries independent of the Git commit: the version is 1.0.0, not 1.0.0+<commit>, so a docs-only
         commit does not change the published exe and its recorded SHA-256 can be reproduced from source. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Reproducible output: deterministic compilation, and no machine-specific source paths (C:\Users\...)
         embedded in binaries or symbols. -->
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>

    <!-- Packages (v1.1 C4, ADR-001): exactly four, referenced only by src/StorageInventory.Library (see nuget.config, which
         refuses everything else). Everything still builds offline once the packages are in the repo-local cache. -->
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <!-- Don't pre-fetch runtime packs for frameworks we never use (e.g. ASP.NET Core) during a self-contained publish. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>

    <!-- BLD-02 / BLD-17: every project has a committed packages.lock.json (content hashes), and every project restores for the
         plain target AND for win-x64, so a locked restore agrees with a locked "-r win-x64" publish (no NU1004, Q-12). A project
         that restores no package gets a lock file with no package in it, which makes a stray dependency show up in review.
         RestoreLockedMode is on in CI and in build.ps1 -Target Publish (which passes it explicitly). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == '' and '$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
