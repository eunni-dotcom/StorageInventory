<?xml version="1.0" encoding="utf-8"?>
<!--
  The only packages ever restored are Microsoft's official .NET runtime packs (which a self-contained publish needs) and
  the four SQLite packages of ADR-001, referenced by src/StorageInventory.Library only. Package source mapping below
  names each by its EXACT ID (no SQLitePCLRaw.* wildcard) and makes NuGet refuse anything else, so an accidental
  dependency (System.Memory included) fails the restore instead of being downloaded.
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.win-x64" />
      <package pattern="Microsoft.Data.Sqlite.Core" />
      <package pattern="SQLitePCLRaw.core" />
      <package pattern="SQLitePCLRaw.provider.e_sqlite3" />
      <package pattern="SQLitePCLRaw.lib.e_sqlite3" />
    </packageSource>
  </packageSourceMapping>
</configuration>
