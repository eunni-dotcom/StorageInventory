+    private static int Orchestrate(string plan, string outDir, string[] extra)
+    {
+        var repeat = extra.Length > 0 ? int.Parse(extra[0], CultureInfo.InvariantCulture) : 3;
+        Directory.CreateDirectory(outDir);
+        var runs = Plan(plan, repeat);
+        var jsonl = Path.Combine(outDir, $"{plan.Replace(':', '-')}.jsonl");
+        var log = Path.Combine(outDir, $"{plan.Replace(':', '-')}.log");
+        using var logWriter = new StreamWriter(log, append: true) { AutoFlush = true };
+        void Log(string line) { Console.WriteLine(line); logWriter.WriteLine(line); }
+        Log($"# plan {plan} x{repeat} started {DateTime.UtcNow:O}, {Environment.ProcessorCount} logical CPUs, exe {Environment.ProcessPath}; {TopProcesses()}");
+        var prefillRoot = Environment.GetEnvironmentVariable("SI_DR_PREFILL_CACHE") ?? Path.Combine(outDir, "prefill-cache");
+        foreach (var run in runs)
+        {
+            Log($"=== {run.Label}");
+            string? libraryCopy = null;
+            if (!run.InProcessPrefill && run.Prefill > 0)
+            {
+                libraryCopy = EnsurePrefill(prefillRoot, run, Log);
+                if (libraryCopy is null) return 1;
+            }
+            var args = new List<string> { "--benchmark", "dr", "child", "--label", run.Label, "--family", run.Family, "--target", run.Target.ToString(CultureInfo.InvariantCulture),
+                "--prefill", run.Prefill.ToString(CultureInfo.InvariantCulture), "--target-source", run.TargetSource, "--churn", run.Churn.ToString(CultureInfo.InvariantCulture),
+                "--mode", run.Mode, "--analyse", run.Analyse ? "1" : "0", "--analysis-dir", Path.Combine(outDir, "analysis"), "--params", run.Params };
+            if (libraryCopy is not null) { args.Add("--prefill-from"); args.Add(libraryCopy); }
+            var report = Path.Combine(outDir, "probe-report.txt");
+            if (File.Exists(report)) File.Delete(report);
+            var guardLog = Path.Combine(outDir, "guard-log.jsonl");
+            if (File.Exists(guardLog)) File.Delete(guardLog);
+            // the run's environment is built explicitly (ChildEnvironment): its declared variables and the per-run instruments only
+            var env = new Dictionary<string, string>(run.Env ?? new Dictionary<string, string>()) { ["SI_DR_PROBE_REPORT"] = report, ["SI_DR_GUARD_LOG"] = guardLog };
+            if (run.Analyse)
+            {
+                Directory.CreateDirectory(Path.Combine(outDir, "analysis"));
+                env["SI_DR_JOURNAL_COPY"] = Path.Combine(outDir, "analysis", Slug(run.Label) + ".precommit.journal");
+            }
+            var (code, json, lines) = RunChild(args, env);
+            foreach (var l in lines) Log("  " + l);
+            if ((code != 0 && run.Mode != "crash") || json is null)
+            {
+                Log($"FAILED ({code})");
+                File.AppendAllText(jsonl, JsonSerializer.Serialize(new { run.Label, failed = code }) + Environment.NewLine);
+                continue;
+            }
+            if (run.Mode == "crash")
+            {
+                using var doc = JsonDocument.Parse(json);
+                var dir = doc.RootElement.GetProperty("LibraryDirectory").GetString()!;
+                var appData = doc.RootElement.GetProperty("AppData").GetString()!;
+                // the same schema variant as the killed run, passed explicitly and recorded with the result (C4DR-O01: a recovery child
+                // of an early probe build lacked SI_DR_PERSOURCE and derived NotALibrary on a correctly recovered Library)
+                var recoverEnv = new Dictionary<string, string>(run.Env ?? new Dictionary<string, string>());
+                var (rc, rjson, rlines) = RunChild(["--benchmark", "dr", "recover", dir, appData], recoverEnv);
+                foreach (var l in rlines) Log("  " + l);
+                json = "{\"crash\":" + json + ",\"recover\":" + (rjson ?? "null") + ",\"recoverEnv\":" + JsonSerializer.Serialize(recoverEnv) + "}";
+                try { Directory.Delete(Path.GetDirectoryName(appData)!, recursive: true); } catch (IOException) { } catch (UnauthorizedAccessException) { }
+                if (rc != 0) Log($"RECOVER FAILED ({rc})");
+            }
+            File.AppendAllText(jsonl, json + Environment.NewLine);
+            Log("  " + Summary(json));
+        }
+        Log($"# plan {plan} finished {DateTime.UtcNow:O}; {TopProcesses()}");
+        return 0;
+    }
+
+    /// <summary>The other processes' CPU use over three seconds (recorded with every plan: the machine is not assumed quiet).</summary>
+    internal static string TopProcesses()
+    {
+        static Dictionary<int, (string Name, TimeSpan Cpu)> Take()
+        {
+            var d = new Dictionary<int, (string, TimeSpan)>();
+            foreach (var p in Process.GetProcesses())
+            {
+                try { d[p.Id] = (p.ProcessName, p.TotalProcessorTime); } catch (Exception ex) when (ex is InvalidOperationException or System.ComponentModel.Win32Exception or NotSupportedException) { }
+                finally { p.Dispose(); }
+            }
+            return d;
+        }
+        var a = Take();
+        Thread.Sleep(3000);
+        var b = Take();
+        var busy = b.Where(kv => a.ContainsKey(kv.Key)).Select(kv => (kv.Value.Name, Cores: (kv.Value.Cpu - a[kv.Key].Cpu).TotalSeconds / 3.0)).Where(x => x.Cores > 0.05)
+            .GroupBy(x => x.Name).Select(g => (Name: g.Key, Cores: g.Sum(x => x.Cores))).OrderByDescending(x => x.Cores).Take(8).ToList();
+        return "busy elsewhere (cores): " + string.Join(", ", busy.Select(x => $"{x.Name} {x.Cores:0.00}")) + $"; total {busy.Sum(x => x.Cores):0.00} of {Environment.ProcessorCount}";
+    }
+
+    private static string Summary(string json)
+    {
+        try
+        {
+            using var doc = JsonDocument.Parse(json);
+            var e = doc.RootElement;
+            if (e.TryGetProperty("crash", out var crash))
+            {
+                var rec = e.GetProperty("recover");
+                return $"crash: journal at kill {crash.GetProperty("JournalAtStopBytes").GetInt64() / 1048576.0:0.0} MiB; next open {(rec.ValueKind == JsonValueKind.Null ? "?" : rec.GetProperty("OpenSeconds").GetDouble().ToString("0.00", CultureInfo.InvariantCulture))} s, state {(rec.ValueKind == JsonValueKind.Null ? "?" : rec.GetProperty("State").GetString())}";
+            }
+            return $"files/s {e.GetProperty("FilesPerSecond").GetDouble():N0}; insertion files/s {e.GetProperty("InsertionFilesPerSecond").GetDouble():N0}; peak journal {e.GetProperty("PeakJournalHandleBytes").GetInt64() / 1048576.0:0.0} MiB (FileInfo {e.GetProperty("PeakJournalFileInfoBytes").GetInt64() / 1048576.0:0.0} MiB); growth {e.GetProperty("GrowthBytes").GetInt64() / 1048576.0:0.0} MiB; library before {e.GetProperty("LibraryBeforeBytes").GetInt64() / 1048576.0:0.0} MiB; new names {e.GetProperty("NewNames").GetInt64():N0}; other load mean {e.GetProperty("OtherLoadMeanPercent").GetDouble():0.0}%";
+        }
+        catch (Exception ex) when (ex is JsonException or KeyNotFoundException or InvalidOperationException)
+        {
+            return "(no summary: " + ex.Message + ")";
+        }
+    }
+
+    private static (int Code, string? Json, List<string> Lines) RunChild(IEnumerable<string> args, Dictionary<string, string>? env)
+    {
+        var info = new ProcessStartInfo(Environment.ProcessPath!) { UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true };
+        foreach (var a in args) info.ArgumentList.Add(a);
+        ChildEnvironment(info.Environment, env);
+        using var process = Process.Start(info)!;
+        var stderr = process.StandardError.ReadToEndAsync();
+        string? json = null;
+        var lines = new List<string>();
+        while (process.StandardOutput.ReadLine() is { } line)
+        {
+            if (line.StartsWith('{')) json = line;
+            else lines.Add(line);
+        }
+        process.WaitForExit();
+        var err = stderr.Result;
+        if (!string.IsNullOrWhiteSpace(err)) lines.Add("stderr: " + err.Trim());
+        return (process.ExitCode, json, lines);
+    }
+
+    /// <summary>A child's environment, built explicitly: the parent's environment without any SI_DR_* variable, then the pass-through
+    /// instruments that name files of this session (the real-names list, the prefill cache), then exactly the variables the caller
+    /// declares. A variable set in the shell that started the orchestrator can therefore never reach a child unannounced.</summary>
+    private static void ChildEnvironment(IDictionary<string, string?> target, IReadOnlyDictionary<string, string>? declared)
+    {
+        foreach (var k in target.Keys.Where(k => k.StartsWith("SI_DR_", StringComparison.OrdinalIgnoreCase)).ToList()) target.Remove(k);
+        foreach (var pass in new[] { "SI_DR_REAL_NAMES", "SI_DR_PREFILL_CACHE", "SI_DR_KEEP_ANALYSIS" })
+            if (Environment.GetEnvironmentVariable(pass) is { } value) target[pass] = value;
+        if (declared is not null) foreach (var (k, v) in declared) target[k] = v;
+    }
+
+    /// <summary>Builds (once) and returns a cached prefilled Library main file. The cache key names every input that changes the
+    /// prefill's content: the generator version, the name family and its parameters, the prefill size, the content-relevant SI_DR_*
+    /// variables (PrefillVariables) and, for the real-vocabulary family, the SHA-256 of the names file. The prefill child receives
+    /// those variables only (C4DR-M06).</summary>
+    private static string? EnsurePrefill(string prefillRoot, RunSpec run, Action<string> log)
+    {
+        var family = PrefillFamily(run.Family);
+        var prefillParams = ObjParams.PrefillPart(run.Params);
+        var env = new Dictionary<string, string>();
+        foreach (var k in PrefillVariables)
+            if (run.Env is not null && run.Env.TryGetValue(k, out var v)) env[k] = v;
+        var keyParts = new List<string> { $"g{GeneratorVersion}", family, run.Prefill.ToString(CultureInfo.InvariantCulture) };
+        if (prefillParams.Length > 0) keyParts.Add(prefillParams.Replace(';', '_').Replace('=', '-'));
+        keyParts.Add(env.ContainsKey("SI_DR_PERSOURCE") ? "persource" : "global");
+        if (family is "real" && Environment.GetEnvironmentVariable("SI_DR_REAL_NAMES") is { } names)
+            keyParts.Add("names-" + Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(File.ReadAllBytes(names)))[..12]);
+        var key = string.Join("-", keyParts);
+        var dir = Path.Combine(prefillRoot, key);
+        var main = Path.Combine(dir, LibraryNames.MainFile);
+        if (File.Exists(main) && File.Exists(main + ".ok")) return main;
+        Directory.CreateDirectory(dir);
+        log($"  building prefill {key} (environment: {(env.Count == 0 ? "none" : string.Join(", ", env.Where(kv => kv.Key != "SI_DR_REAL_NAMES").Select(kv => kv.Key + "=" + kv.Value)))})");
+        var (code, json, lines) = RunChild(["--benchmark", "dr", "prefill", "--family", family, "--prefill", run.Prefill.ToString(CultureInfo.InvariantCulture), "--params", prefillParams, "--out", main], env);
+        foreach (var l in lines) log("    " + l);
+        if (code != 0) { log($"  prefill FAILED ({code})"); return null; }
+        File.WriteAllText(main + ".ok", JsonSerializer.Serialize(new { key, environment = env.Keys.Order(StringComparer.Ordinal).ToArray(), built = json }));
+        return main;
+    }
+
+    /// <summary>The prefill's own name family: a rescan target re-uses the hash family's prefill.</summary>
+    private static string PrefillFamily(string family) => family switch { "rescan" => "hash", "rescanreal" => "real", "objrescan" => "obj", _ => family };
