+    private static void DoPrefill(LibrarySession session, string family, long prefill)
+    {
+        // the Library already holds other snapshots AND another source (G0-O03): source A twice (p1, p3), source B once (p2)
+        ImportSourceSpec? sourceA = null;
+        for (var i = 1; i <= 3; i++)
+        {
+            var other = i == 2;
+            var snapshot = new DrSnapshot((int)Folders(prefill), seed: i, label: "p" + i, family, realList: other ? 1 : 0);
+            var spec = other ? SyntheticSnapshot.NewSource(@"\Other", serial: 0x7777ABCD) : sourceA ?? SyntheticSnapshot.NewSource();
+            var result = Import(session, snapshot, "prefill-" + i, spec, null, CancellationToken.None, out _);
+            if (i == 1) sourceA = new ImportSourceSpec.Existing(result.SourceId);
+        }
+    }
