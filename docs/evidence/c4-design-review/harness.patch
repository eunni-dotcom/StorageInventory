+    private sealed record Options(string Label, string Family, long Target, long Prefill, string TargetSource, double Churn, string Mode, bool Analyse, string AnalysisDir, string? PrefillFrom, string Params);
+
+    private static Options ParseOptions(string[] args)
+    {
+        string Opt(string name, string fallback) { var i = Array.IndexOf(args, "--" + name); return i >= 0 && i + 1 < args.Length ? args[i + 1] : fallback; }
+        return new Options(Opt("label", "run"), Opt("family", "append"), long.Parse(Opt("target", "1000000"), CultureInfo.InvariantCulture),
+            long.Parse(Opt("prefill", "250000"), CultureInfo.InvariantCulture), Opt("target-source", "existing"), double.Parse(Opt("churn", "0"), CultureInfo.InvariantCulture),
+            Opt("mode", "normal"), Opt("analyse", "0") == "1", Opt("analysis-dir", Path.GetTempPath()), args.Contains("--prefill-from") ? Opt("prefill-from", "") : null,
+            Opt("params", ""));
+    }
+
+    private static long Folders(long files) => Math.Max(10, files / 4);
+
+    private static int Prefill(string[] args)
+    {
+        string Opt(string name) { var i = Array.IndexOf(args, "--" + name); return i >= 0 && i + 1 < args.Length ? args[i + 1] : ""; }
+        var family = Opt("family");
+        var prefill = long.Parse(Opt("prefill"), CultureInfo.InvariantCulture);
+        var outMain = Opt("out");
+        var prefillParams = Opt("params");
+        var root = Path.Combine(BenchRoot(), "SI-DR-Prefill", Guid.NewGuid().ToString("N")[..10]);
+        var appData = Path.Combine(root, "AppData");
+        var directory = Path.Combine(appData, "Library");
+        Directory.CreateDirectory(appData);
+        try
+        {
+            var watch = Stopwatch.StartNew();
+            var session = new LibrarySession(directory, appData);
+            session.RunStartupOpen();
+            using (var create = Lease(session, MutationKind.Create)) session.CreateLibrary(create);
+            DoPrefill(session, family, prefill, prefillParams);
+            session.TestOnlyShutdown();
+            var main = Path.Combine(directory, LibraryNames.MainFile);
+            File.Copy(main, outMain, overwrite: true);
+            using (var fs = new FileStream(outMain, FileMode.Open, FileAccess.ReadWrite, FileShare.None)) fs.Flush(flushToDisk: true);
+            var bytes = HandleLength(outMain);
+            var probe = string.Join(", ", Environment.GetEnvironmentVariables().Keys.Cast<string>().Where(k => k.StartsWith("SI_DR_", StringComparison.Ordinal) && !IsPathVariable(k)).Order(StringComparer.Ordinal));
+            Console.WriteLine($"prefill {family} 3x{prefill:N0} {prefillParams} built in {watch.Elapsed.TotalSeconds:0.0} s, {bytes / 1048576.0:0.0} MiB ({bytes:N0} B); SI_DR_* seen by the prefill child: {(probe.Length == 0 ? "none" : probe)}");
+            Console.WriteLine(JsonSerializer.Serialize(new { family, prefill, prefillParams, generator = GeneratorVersion, bytes, seconds = watch.Elapsed.TotalSeconds, environment = probe }));
+            return 0;
+        }
+        finally
+        {
+            TryDelete(root);
+        }
+    }
+
+    /// <summary>The routine churn of the objective re-scan family: the prefill's second snapshot of source A (p3) is p1 re-scanned with it.</summary>
+    internal const string RoutineChurn = "rho=0.01;delta=0.005;alpha=0.005";
+
+    private static void DoPrefill(LibrarySession session, string family, long prefill, string prefillParams = "")
+    {
+        // the Library already holds other snapshots AND another source (G0-O03): source A twice (p1, p3), source B once (p2)
+        ImportSourceSpec? sourceA = null;
+        for (var i = 1; i <= 3; i++)
+        {
+            var other = i == 2;
+            if (family == "obj")
+            {
+                // objective families: p1 = source A's first save (vocabulary seed 1); p2 = source B (seed 2), sharing a fraction Omega of
+                // its entries with the target first save's vocabulary (seed 4); p3 = p1 re-scanned with the routine churn (layer 3)
+                var p = ObjParams.Parse(prefillParams);
+                ISnapshotRowSource obj = i switch
+                {
+                    1 => new ObjSnapshot((int)Folders(prefill), treeSeed: 1, p, vocabSeed: 1),
+                    2 => new ObjSnapshot((int)Folders(prefill), treeSeed: 2, p, vocabSeed: 2, sharedSeed: 4),
+                    _ => new ObjSnapshot((int)Folders(prefill), treeSeed: 1, ObjParams.Parse(prefillParams + ";" + RoutineChurn), vocabSeed: 1, layer: 3),
+                };
+                var objSpec = other ? SyntheticSnapshot.NewSource(@"\Other", serial: 0x7777ABCD) : sourceA ?? SyntheticSnapshot.NewSource();
+                var objResult = Import(session, obj, "prefill-" + i, objSpec, null, CancellationToken.None, out _);
+                if (i == 1) sourceA = new ImportSourceSpec.Existing(objResult.SourceId);
+                continue;
+            }
+            var snapshot = new DrSnapshot((int)Folders(prefill), seed: i, label: "p" + i, family, realList: other ? 1 : 0);
+            var spec = other ? SyntheticSnapshot.NewSource(@"\Other", serial: 0x7777ABCD) : sourceA ?? SyntheticSnapshot.NewSource();
+            var result = Import(session, snapshot, "prefill-" + i, spec, null, CancellationToken.None, out _);
+            if (i == 1) sourceA = new ImportSourceSpec.Existing(result.SourceId);
+        }
+    }
