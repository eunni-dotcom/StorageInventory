+    // ================================================================================================================ the parent
+
+    private static int Orchestrate(string plan, string outDir, string[] extra)
+    {
+        var repeat = extra.Length > 0 ? int.Parse(extra[0], CultureInfo.InvariantCulture) : 3;
+        Directory.CreateDirectory(outDir);
+        var runs = Plan(plan, repeat);
+        var jsonl = Path.Combine(outDir, $"{plan.Replace(':', '-')}.jsonl");
+        var log = Path.Combine(outDir, $"{plan.Replace(':', '-')}.log");
+        using var logWriter = new StreamWriter(log, append: true) { AutoFlush = true };
+        void Log(string line) { Console.WriteLine(line); logWriter.WriteLine(line); }
+        Log($"# plan {plan} x{repeat} started {DateTime.UtcNow:O}, {Environment.ProcessorCount} logical CPUs, exe {Environment.ProcessPath}; {TopProcesses()}");
+        var prefillRoot = Environment.GetEnvironmentVariable("SI_DR_PREFILL_CACHE") ?? Path.Combine(outDir, "prefill-cache");
+        foreach (var run in runs)
+        {
+            Log($"=== {run.Label}");
+            string? libraryCopy = null;
+            if (!run.InProcessPrefill && run.Prefill > 0)
+            {
+                libraryCopy = EnsurePrefill(prefillRoot, run, Log);
+                if (libraryCopy is null) return 1;
+            }
+            var args = new List<string> { "--benchmark", "dr", "child", "--label", run.Label, "--family", run.Family, "--target", run.Target.ToString(CultureInfo.InvariantCulture),
+                "--prefill", run.Prefill.ToString(CultureInfo.InvariantCulture), "--target-source", run.TargetSource, "--churn", run.Churn.ToString(CultureInfo.InvariantCulture),
+                "--mode", run.Mode, "--analyse", run.Analyse ? "1" : "0", "--analysis-dir", Path.Combine(outDir, "analysis") };
+            if (libraryCopy is not null) { args.Add("--prefill-from"); args.Add(libraryCopy); }
+            var report = Path.Combine(outDir, "probe-report.txt");
+            if (File.Exists(report)) File.Delete(report);
+            var env = new Dictionary<string, string>(run.Env ?? new Dictionary<string, string>()) { ["SI_DR_PROBE_REPORT"] = report };
+            var (code, json, lines) = RunChild(args, env);
+            foreach (var l in lines) Log("  " + l);
+            if ((code != 0 && run.Mode != "crash") || json is null)
+            {
+                Log($"FAILED ({code})");
+                File.AppendAllText(jsonl, JsonSerializer.Serialize(new { run.Label, failed = code }) + Environment.NewLine);
+                continue;
+            }
+            if (run.Mode == "crash")
+            {
+                using var doc = JsonDocument.Parse(json);
+                var dir = doc.RootElement.GetProperty("LibraryDirectory").GetString()!;
+                var appData = doc.RootElement.GetProperty("AppData").GetString()!;
+                var (rc, rjson, rlines) = RunChild(["--benchmark", "dr", "recover", dir, appData], run.Env);   // the same schema variant as the killed run
+                foreach (var l in rlines) Log("  " + l);
+                json = "{\"crash\":" + json + ",\"recover\":" + (rjson ?? "null") + "}";
+                try { Directory.Delete(Path.GetDirectoryName(appData)!, recursive: true); } catch (IOException) { } catch (UnauthorizedAccessException) { }
+                if (rc != 0) Log($"RECOVER FAILED ({rc})");
+            }
+            File.AppendAllText(jsonl, json + Environment.NewLine);
+            Log("  " + Summary(json));
+        }
+        Log($"# plan {plan} finished {DateTime.UtcNow:O}; {TopProcesses()}");
+        return 0;
+    }
+
+    /// <summary>The other processes' CPU use over three seconds (recorded with every plan: the machine is not assumed quiet).</summary>
+    internal static string TopProcesses()
+    {
+        static Dictionary<int, (string Name, TimeSpan Cpu)> Take()
+        {
+            var d = new Dictionary<int, (string, TimeSpan)>();
+            foreach (var p in Process.GetProcesses())
+            {
+                try { d[p.Id] = (p.ProcessName, p.TotalProcessorTime); } catch (Exception ex) when (ex is InvalidOperationException or System.ComponentModel.Win32Exception or NotSupportedException) { }
+                finally { p.Dispose(); }
+            }
+            return d;
+        }
+        var a = Take();
+        Thread.Sleep(3000);
+        var b = Take();
+        var busy = b.Where(kv => a.ContainsKey(kv.Key)).Select(kv => (kv.Value.Name, Cores: (kv.Value.Cpu - a[kv.Key].Cpu).TotalSeconds / 3.0)).Where(x => x.Cores > 0.05)
+            .GroupBy(x => x.Name).Select(g => (Name: g.Key, Cores: g.Sum(x => x.Cores))).OrderByDescending(x => x.Cores).Take(8).ToList();
+        return "busy elsewhere (cores): " + string.Join(", ", busy.Select(x => $"{x.Name} {x.Cores:0.00}")) + $"; total {busy.Sum(x => x.Cores):0.00} of {Environment.ProcessorCount}";
+    }
+
+    private static string Summary(string json)
+    {
+        try
+        {
+            using var doc = JsonDocument.Parse(json);
+            var e = doc.RootElement;
+            if (e.TryGetProperty("crash", out var crash))
+            {
+                var rec = e.GetProperty("recover");
+                return $"crash: journal at kill {crash.GetProperty("JournalAtStopBytes").GetInt64() / 1048576.0:0.0} MB; next open {(rec.ValueKind == JsonValueKind.Null ? "?" : rec.GetProperty("OpenSeconds").GetDouble().ToString("0.00", CultureInfo.InvariantCulture))} s, state {(rec.ValueKind == JsonValueKind.Null ? "?" : rec.GetProperty("State").GetString())}";
+            }
+            return $"files/s {e.GetProperty("FilesPerSecond").GetDouble():N0}; insertion files/s {e.GetProperty("InsertionFilesPerSecond").GetDouble():N0}; peak journal {e.GetProperty("PeakJournalHandleBytes").GetInt64() / 1048576.0:0.0} MB (FileInfo {e.GetProperty("PeakJournalFileInfoBytes").GetInt64() / 1048576.0:0.0} MB); growth {e.GetProperty("GrowthBytes").GetInt64() / 1048576.0:0.0} MB; library before {e.GetProperty("LibraryBeforeBytes").GetInt64() / 1048576.0:0.0} MB; new names {e.GetProperty("NewNames").GetInt64():N0}; other load mean {e.GetProperty("OtherLoadMeanPercent").GetDouble():0.0}%";
