+    /// <summary>Harvests file NAMES (never paths) from three system trees into a scratch file: list 0 C:\Program Files, list 1
+    /// C:\Program Files (x86), list 2 C:\Windows. Only aggregates are ever reported.</summary>
+    private static int Harvest(string outFile)
+    {
+        var roots = new[] { @"C:\Program Files", @"C:\Program Files (x86)", @"C:\Windows" };
+        using var writer = new BinaryWriter(File.Create(outFile), Encoding.Unicode);
+        writer.Write(roots.Length);
+        foreach (var root in roots)
+        {
+            var names = new List<string>();
+            var options = new EnumerationOptions { RecurseSubdirectories = true, IgnoreInaccessible = true, AttributesToSkip = 0, ReturnSpecialDirectories = false };
+            try
+            {
+                foreach (var file in Directory.EnumerateFiles(root, "*", options)) names.Add(Path.GetFileName(file));
+            }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { }
+            writer.Write(names.Count);
+            foreach (var n in names) writer.Write(n);
+            var distinct = names.Distinct(StringComparer.Ordinal).Count();
+            Console.WriteLine($"list {Array.IndexOf(roots, root)}: {names.Count:N0} names, {distinct:N0} distinct, mean {names.Average(n => n.Length):0.0} UTF-16 code units");
+        }
+        return 0;
+    }
+
+    internal static class RealNames
+    {
+        private static string[][]? _lists;
+
+        internal static string[] List(int index)
+        {
+            if (_lists is null)
+            {
+                var path = Environment.GetEnvironmentVariable("SI_DR_REAL_NAMES") ?? throw new InvalidOperationException("SI_DR_REAL_NAMES is not set");
+                using var reader = new BinaryReader(File.OpenRead(path), Encoding.Unicode);
+                var count = reader.ReadInt32();
+                var lists = new string[count][];
+                for (var i = 0; i < count; i++)
+                {
+                    var n = reader.ReadInt32();
+                    lists[i] = new string[n];
+                    for (var k = 0; k < n; k++) lists[i][k] = reader.ReadString();
+                }
+                _lists = lists;
+            }
+            return _lists[index];
+        }
+    }
