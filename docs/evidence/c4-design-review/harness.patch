+/// <summary>C4 design repair: summarises the IMP-11 instrument of the probe build (one JSON line per check: kind, rows, page_count,
+/// page_size, main and journal length through handles). Pending main growth at a check = page_count x page_size - main length; the
+/// growth that COMMIT adds = main after COMMIT - main before COMMIT; the drop per interval = growth of main + journal between two
+/// consecutive row checks (16,384 rows apart).</summary>
+internal static class Guard
+{
+    internal static string Summarise(string[] lines)
+    {
+        var rows = lines.Where(l => l.StartsWith('{')).Select(l => JsonDocument.Parse(l).RootElement).ToList();
+        long Get(JsonElement e, string k) => e.GetProperty(k).GetInt64();
+        long Pending(JsonElement e) => Get(e, "pc") < 0 ? 0 : Math.Max(0, Get(e, "pc") * Get(e, "ps") - Get(e, "main"));
+        var pre = rows.LastOrDefault(e => e.GetProperty("k").GetString() == "precommit");
+        var post = rows.LastOrDefault(e => e.GetProperty("k").GetString() == "postcommit");
+        var endrows = rows.LastOrDefault(e => e.GetProperty("k").GetString() == "endrows");
+        var verified = rows.LastOrDefault(e => e.GetProperty("k").GetString() == "verified");
+        var begin = rows.FirstOrDefault(e => e.GetProperty("k").GetString() == "begin");
+        var checks = rows.Where(e => e.GetProperty("k").GetString() is "rows" or "folders").ToList();
+        long maxInterval = 0, maxPending = 0;
+        for (var i = 1; i < checks.Count; i++)
+        {
+            var grow = Get(checks[i], "main") + Get(checks[i], "journal") - Get(checks[i - 1], "main") - Get(checks[i - 1], "journal");
+            var rowsApart = Math.Max(1, Get(checks[i], "rows") - Get(checks[i - 1], "rows"));
+            if (Get(checks[i], "rows") > Get(checks[i - 1], "rows")) maxInterval = Math.Max(maxInterval, grow * 4_096 / rowsApart);
+        }
+        foreach (var c in rows) maxPending = Math.Max(maxPending, Pending(c));
+        var sb = new StringBuilder();
+        sb.Append(CultureInfo.InvariantCulture, $"checks {rows.Count}; max pending main growth at any check {maxPending} B; largest drop per 4,096 rows (scaled from 16,384-row intervals) {maxInterval} B");
+        if (endrows.ValueKind == JsonValueKind.Object) sb.Append(CultureInfo.InvariantCulture, $"; end of rows: pending {Pending(endrows)} B, main {Get(endrows, "main")} B, journal {Get(endrows, "journal")} B");
+        if (verified.ValueKind == JsonValueKind.Object && endrows.ValueKind == JsonValueKind.Object)
+            sb.Append(CultureInfo.InvariantCulture, $"; during verification main grew {Get(verified, "main") - Get(endrows, "main")} B, journal {Get(verified, "journal") - Get(endrows, "journal")} B");
+        if (pre.ValueKind == JsonValueKind.Object)
+        {
+            sb.Append(CultureInfo.InvariantCulture, $"; before COMMIT: page_count {Get(pre, "pc")}, page_size {Get(pre, "ps")}, main {Get(pre, "main")} B, journal {Get(pre, "journal")} B, pending {Pending(pre)} B");
+            if (post.ValueKind == JsonValueKind.Object)
+                sb.Append(CultureInfo.InvariantCulture, $"; after COMMIT: main {Get(post, "main")} B (COMMIT added {Get(post, "main") - Get(pre, "main")} B; predicted {Pending(pre)} B; difference {Get(post, "main") - Get(pre, "main") - Pending(pre)} B), journal {Get(post, "journal")} B");
+        }
+        if (begin.ValueKind == JsonValueKind.Object && pre.ValueKind == JsonValueKind.Object)
+            sb.Append(CultureInfo.InvariantCulture, $"; total growth from BEGIN: pages {Get(pre, "pc") - Get(begin, "pc")}");
+        return sb.ToString();
+    }
+}
