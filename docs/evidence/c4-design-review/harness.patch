+using System.Buffers.Binary;
+using System.Diagnostics;
+using System.Globalization;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Text.Json;
+using StorageInventory.Core;
+using StorageInventory.Core.Identity;
+using StorageInventory.History.Identity;
+using StorageInventory.History.Library;
+
+namespace StorageInventory.Library.Tests;
+
+/// <summary>
+/// C4 design review (C4-B01 / C4-H02) reproduction harness. NOT part of the product or of the committed test suite: a scratch
+/// harness kept as a patch in docs/evidence/c4-design-review. It drives the unmodified production T-IMPORT (SnapshotImporter
+/// through LibrarySession.ImportSnapshotAsync) with several file-name distributions and Library sizes, samples the rollback journal
+/// through a live handle every 1 ms, records machine load, and can attribute every journalled page to the B-tree that owned it
+/// before the import (by walking a copy of the pre-import database file; the shipped engine has no dbstat).
+/// <para>Usage: StorageInventory.Library.Tests.exe --benchmark dr plan &lt;plan&gt; &lt;outDir&gt;</para>
+/// </summary>
+internal static class DesignReviewBench
+{
+    internal static int Run(string[] args)
+    {
+        return args switch
+        {
+            ["child", ..] => Child(args[1..]),
+            ["recover", var dir, var appData] => Recover(dir, appData),
+            ["prefill", ..] => Prefill(args[1..]),
+            ["harvest", var outFile] => Harvest(outFile),
+            ["plan", var plan, var outDir, ..] => Orchestrate(plan, outDir, args[3..]),
+            _ => Usage(),
+        };
+    }
+
+    private static int Usage()
+    {
+        Console.Error.WriteLine("usage: --benchmark dr plan <name> <outDir> | child ... | recover <dir> <appData> | prefill ... | harvest <file>");
+        return 2;
+    }
+
+    // ================================================================================================================ the plans
+
+    internal sealed record RunSpec(string Label, string Family, long Target, long Prefill, string TargetSource = "existing", double Churn = 0,
+        string Mode = "normal", bool Analyse = false, Dictionary<string, string>? Env = null, bool InProcessPrefill = false, string Params = "");
+
+    /// <summary>C4 design repair: bumped whenever a generator changes what a prefill contains, so a cached prefill of an older
+    /// generator can never be reused (the cache key carries it).</summary>
+    internal const int GeneratorVersion = 3;
+
+    /// <summary>The SI_DR_* variables that change what a PREFILL contains (its schema variant and its name source). Every other SI_DR_*
+    /// variable (key-ordered interning, cache size, batching, instruments) is removed from a prefill child's environment, so a prefill is
+    /// always built by the unmodified importer of its schema variant (C4DR-M06: the old cache key ignored SI_DR_PRESORT and the prefill
+    /// child inherited the triggering run's whole environment).</summary>
+    private static readonly string[] PrefillVariables = ["SI_DR_PERSOURCE", "SI_DR_REAL_NAMES"];
+
+    private static List<RunSpec> Plan(string name, int repeat)
+    {
+        var runs = new List<RunSpec>();
+        const long K = 1000;
+        var three = new (long T, long P)[] { (1_000 * K, 250 * K), (2_000 * K, 250 * K), (1_000 * K, 1_000 * K) };
+        switch (name)
+        {
+            case "smoke":
+                runs.Add(new("smoke append", "append", 200 * K, 50 * K));
+                runs.Add(new("smoke hash", "hash", 200 * K, 50 * K, Analyse: true));
+                runs.Add(new("smoke mixed", "mixed", 200 * K, 50 * K));
+                runs.Add(new("smoke rescan", "rescan", 50 * K, 50 * K, Churn: 0.01));
+                runs.Add(new("smoke cancel", "hash", 200 * K, 50 * K, Mode: "cancel"));
+                runs.Add(new("smoke crash", "hash", 200 * K, 50 * K, Mode: "crash"));
+                break;
+            case "repro":   // families 1 and 2 at the three required configurations, interleaved so slow drift hits every cell
+                for (var r = 1; r <= repeat; r++)
+                    foreach (var (t, p) in three)
+                        foreach (var fam in new[] { "append", "hash" })
+                            runs.Add(new($"{fam} {t / 1_000_000}M/{3 * p / 1000}k r{r}", fam, t, p));
+                break;
+            case "mixed":   // family 3: realistic mixtures
+                for (var r = 1; r <= repeat; r++)
+                    foreach (var (t, p) in three)
+                        foreach (var fam in new[] { "mixed", "real" })
+                            runs.Add(new($"{fam} {t / 1_000_000}M/{3 * p / 1000}k r{r}", fam, t, p));
+                break;
+            case "rescan":  // the periodic case: the same source again with a little churn
+                for (var r = 1; r <= repeat; r++)
+                {
+                    runs.Add(new($"rescan 1% 1M/3000k r{r}", "rescan", 1_000 * K, 1_000 * K, Churn: 0.01));
+                    runs.Add(new($"rescan 5% 1M/3000k r{r}", "rescan", 1_000 * K, 1_000 * K, Churn: 0.05));
+                    runs.Add(new($"rescan 1% 250k/750k r{r}", "rescan", 250 * K, 250 * K, Churn: 0.01));
+                }
+                break;
+            case "size":    // family 4: Library-size sensitivity at a fixed 1M target
+                for (var r = 1; r <= repeat; r++)
+                {
+                    foreach (var p in new long[] { 0, 100 * K, 250 * K, 500 * K, 1_000 * K, 2_000 * K })
+                        runs.Add(new($"hash 1M/{3 * p / 1000}k r{r}", "hash", 1_000 * K, p));
+                    runs.Add(new($"append 1M/6000k r{r}", "append", 1_000 * K, 2_000 * K));
+                    runs.Add(new($"hash 2M/3000k r{r}", "hash", 2_000 * K, 1_000 * K));
+                }
+                break;
+            case "newsource":   // the same interleaved names, but the target is the first snapshot of a NEW source
+                for (var r = 1; r <= repeat; r++)
+                    foreach (var (t, p) in three)
+                        runs.Add(new($"hash new-source {t / 1_000_000}M/{3 * p / 1000}k r{r}", "hash", t, p, TargetSource: "new"));
+                break;
+            case "big":
+                runs.Add(new("append 10M/750k", "append", 10_000 * K, 250 * K));
+                runs.Add(new("hash 10M/750k", "hash", 10_000 * K, 250 * K));
+                break;
+            case "analyse":   // journal composition (one run each; the journal copy perturbs timing, so these are not timed results)
+                runs.Add(new("analyse append 1M/3000k", "append", 1_000 * K, 1_000 * K, Analyse: true));
+                runs.Add(new("analyse hash 1M/750k", "hash", 1_000 * K, 250 * K, Analyse: true));
+                runs.Add(new("analyse hash 2M/750k", "hash", 2_000 * K, 250 * K, Analyse: true));
+                runs.Add(new("analyse hash 1M/3000k", "hash", 1_000 * K, 1_000 * K, Analyse: true));
+                runs.Add(new("analyse hash new-source 1M/3000k", "hash", 1_000 * K, 1_000 * K, TargetSource: "new", Analyse: true));
+                runs.Add(new("analyse mixed 1M/3000k", "mixed", 1_000 * K, 1_000 * K, Analyse: true));
+                runs.Add(new("analyse real 1M/3000k", "real", 1_000 * K, 1_000 * K, Analyse: true));
+                runs.Add(new("analyse rescan 1% 1M/3000k", "rescan", 1_000 * K, 1_000 * K, Churn: 0.01, Analyse: true));
+                break;
+            case "rollback":   // cancellation at the journal's peak and a crash there (then the next open's recovery)
+                for (var r = 1; r <= repeat; r++)
+                {
+                    runs.Add(new($"cancel append 1M/3000k r{r}", "append", 1_000 * K, 1_000 * K, Mode: "cancel"));
+                    runs.Add(new($"cancel hash 1M/750k r{r}", "hash", 1_000 * K, 250 * K, Mode: "cancel"));
+                    runs.Add(new($"cancel hash 1M/3000k r{r}", "hash", 1_000 * K, 1_000 * K, Mode: "cancel"));
+                    runs.Add(new($"cancel hash 2M/6000k r{r}", "hash", 2_000 * K, 2_000 * K, Mode: "cancel"));
+                    runs.Add(new($"crash hash 1M/3000k r{r}", "hash", 1_000 * K, 1_000 * K, Mode: "crash"));
+                    runs.Add(new($"crash append 1M/3000k r{r}", "append", 1_000 * K, 1_000 * K, Mode: "crash"));
+                }
+                break;
+            case "extra":   // the worst-case cell with C4's mechanics: 2M into three 2M snapshots, normal and killed
+                for (var r = 1; r <= repeat; r++)
+                {
+                    runs.Add(new($"hash 2M/6000k r{r}", "hash", 2_000 * K, 2_000 * K));
+                    runs.Add(new($"mixed 2M/6000k r{r}", "mixed", 2_000 * K, 2_000 * K));
+                }
+                runs.Add(new("crash hash 2M/6000k", "hash", 2_000 * K, 2_000 * K, Mode: "crash"));
+                break;
+            case "realrescan":   // the periodic save of a source with a real vocabulary (C4's mechanics)
+                for (var r = 1; r <= repeat; r++)
+                {
+                    runs.Add(new($"rescanreal 1% 1M/3000k r{r}", "rescanreal", 1_000 * K, 1_000 * K, Churn: 0.01));
+                    runs.Add(new($"rescanreal 1% 2M/6000k r{r}", "rescanreal", 2_000 * K, 2_000 * K, Churn: 0.01));
+                    runs.Add(new($"real new-source 2M/6000k r{r}", "real", 2_000 * K, 2_000 * K, TargetSource: "new"));
+                }
+                break;
+            case "prefillcheck":   // the cached-prefill method against the in-process prefill of the original benchmark
+                for (var r = 1; r <= repeat; r++)
+                {
+                    runs.Add(new($"hash 1M/750k cached r{r}", "hash", 1_000 * K, 250 * K));
+                    runs.Add(new($"hash 1M/750k in-process r{r}", "hash", 1_000 * K, 250 * K, InProcessPrefill: true));
+                }
+                break;
+            default:
+                if (name.StartsWith("probe:", StringComparison.Ordinal)) return ProbePlan(name[6..], repeat);
+                if (name.StartsWith("repair:", StringComparison.Ordinal)) return RepairPlan(name[7..], repeat);
+                throw new ArgumentException("unknown plan " + name);
+        }
+        return runs;
+    }
