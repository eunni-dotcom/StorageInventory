+    /// <summary>System-wide CPU load other than this process, from GetSystemTimes and the process's own CPU time, every 250 ms.</summary>
+    private sealed class LoadSampler
+    {
+        [StructLayout(LayoutKind.Sequential)]
+        private struct FileTime { public uint Low; public uint High; public readonly long Value => ((long)High << 32) | Low; }
+
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool GetSystemTimes(out FileTime idle, out FileTime kernel, out FileTime user);
+
+        private readonly List<double> _other = [];
+        private Thread? _thread;
+        private volatile bool _stop;
+
+        internal void Start()
+        {
+            _thread = new Thread(() =>
+            {
+                GetSystemTimes(out var i0, out var k0, out var u0);
+                var p0 = Process.GetCurrentProcess().TotalProcessorTime.Ticks;
+                while (!_stop)
+                {
+                    Thread.Sleep(250);
+                    GetSystemTimes(out var i1, out var k1, out var u1);
+                    var p1 = Process.GetCurrentProcess().TotalProcessorTime.Ticks;
+                    var total = (k1.Value - k0.Value) + (u1.Value - u0.Value);   // kernel includes idle
+                    var busy = total - (i1.Value - i0.Value);
+                    var own = p1 - p0;
+                    if (total > 0) lock (_other) _other.Add(Math.Max(0, 100.0 * (busy - own) / total));
+                    i0 = i1; k0 = k1; u0 = u1; p0 = p1;
+                }
+            }) { IsBackground = true };
+            _thread.Start();
+        }
+
+        internal (double Mean, double P95, double Max) Stop()
+        {
+            _stop = true;
+            _thread?.Join();
+            lock (_other)
+            {
+                if (_other.Count == 0) return (0, 0, 0);
+                var sorted = _other.OrderBy(x => x).ToArray();
+                return (sorted.Average(), sorted[(int)Math.Min(sorted.Length - 1, Math.Ceiling(0.95 * sorted.Length) - 1)], sorted[^1]);
+            }
+        }
+    }
+}
