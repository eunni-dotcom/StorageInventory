+    private static int Prefill(string[] args)
+    {
+        string Opt(string name) { var i = Array.IndexOf(args, "--" + name); return args[i + 1]; }
+        var family = Opt("family");
+        var prefill = long.Parse(Opt("prefill"), CultureInfo.InvariantCulture);
+        var outMain = Opt("out");
+        var root = Path.Combine(BenchRoot(), "SI-DR-Prefill", Guid.NewGuid().ToString("N")[..10]);
+        var appData = Path.Combine(root, "AppData");
+        var directory = Path.Combine(appData, "Library");
+        Directory.CreateDirectory(appData);
+        try
+        {
+            var watch = Stopwatch.StartNew();
+            var session = new LibrarySession(directory, appData);
+            session.RunStartupOpen();
+            using (var create = Lease(session, MutationKind.Create)) session.CreateLibrary(create);
+            DoPrefill(session, family, prefill);
+            session.TestOnlyShutdown();
+            var main = Path.Combine(directory, LibraryNames.MainFile);
+            File.Copy(main, outMain, overwrite: true);
+            using (var fs = new FileStream(outMain, FileMode.Open, FileAccess.ReadWrite, FileShare.None)) fs.Flush(flushToDisk: true);
+            Console.WriteLine($"prefill {family} 3x{prefill:N0} built in {watch.Elapsed.TotalSeconds:0.0} s, {new FileInfo(outMain).Length / 1048576.0:0.0} MB");
+            Console.WriteLine(JsonSerializer.Serialize(new { family, prefill, bytes = new FileInfo(outMain).Length, seconds = watch.Elapsed.TotalSeconds }));
+            return 0;
+        }
+        finally
+        {
+            TryDelete(root);
+        }
+    }
