+    {
+        var main = Path.Combine(directory, LibraryNames.MainFile);
+        var journal = Path.Combine(directory, LibraryNames.JournalFile);
+        var journalBefore = HandleLengthOrZero(journal);
+        var mainBefore = HandleLengthOrZero(main);
+        var watch = Stopwatch.StartNew();
+        var session = new LibrarySession(directory, appData);
+        var status = session.RunStartupOpen();
+        var openSeconds = watch.Elapsed.TotalSeconds;
+        var snapshots = status.State == LibraryState.Available ? session.Read(r => r.Long("SELECT count(*) FROM snapshot")) : -1;
+        string? verify = null;
+        if (status.State == LibraryState.Available)
+        {
+            for (var id = 1; id <= 3 && verify is null; id++) verify = session.Read(r => SnapshotVerifier.VerifyPublished(r, id));
+        }
+        session.TestOnlyShutdown();
+        var mainAfter = HandleLengthOrZero(main);
+        // older snapshots are reported verified only when they were verified: a state other than Available skips the check, which is
+        // recorded as null with the reason (C4DR-O01: the old harness wrote "true" for a skipped check)
+        var verified = status.State == LibraryState.Available;
+        bool? olderVerify = verified ? verify is null : null;
+        var perSource = Environment.GetEnvironmentVariable("SI_DR_PERSOURCE") ?? "unset";
+        Console.WriteLine($"recovery open: {openSeconds:0.000} s, hot journal {journalBefore / 1048576.0:0.0} MiB, main {mainBefore / 1048576.0:0.0} -> {mainAfter / 1048576.0:0.0} MiB, state {status.State}, snapshots {snapshots}, older snapshots {(!verified ? "NOT VERIFIED (state " + status.State + ")" : verify is null ? "verify" : "FAIL " + verify)}; SI_DR_PERSOURCE {perSource}");
+        Console.WriteLine(JsonSerializer.Serialize(new { OpenSeconds = openSeconds, HotJournalBytes = journalBefore, MainBeforeBytes = mainBefore, MainAfterBytes = mainAfter, State = status.State.ToString(), Snapshots = snapshots, OlderSnapshotsVerify = olderVerify, VerifySkippedReason = verified ? null : "state " + status.State, RecoverPerSource = perSource }));
+        return 0;
+    }
