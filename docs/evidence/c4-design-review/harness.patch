+    /// <summary>C4 design repair: the focused reruns (need the probe build; every run also records IMP-11's pending growth through
+    /// the SI_DR_GUARD_LOG instrument). "obj" and "objrescan" are the objective families of the repaired §15.4 (ObjSnapshot).</summary>
+    private static List<RunSpec> RepairPlan(string name, int repeat)
+    {
+        var runs = new List<RunSpec>();
+        const long K = 1000;
+        Dictionary<string, string> PerSource() => new() { ["SI_DR_PERSOURCE"] = "1" };
+        const string First25 = "d=0.25;model=system";
+        const string First60 = "d=0.60;model=data";
+        const string Rescan1 = "d=0.25;model=system;rho=0.01;delta=0.005;alpha=0.005";
+        const string Rescan10 = "d=0.25;model=system;rho=0.10;delta=0.05;alpha=0.05";
+        switch (name)
+        {
+            case "structure":   // PERF-15 (a) key-range attribution, positive cells and the global-dictionary negative control
+                runs.Add(new("analyse persource hash new-source 1M/3000k", "hash", 1_000 * K, 1_000 * K, TargetSource: "new", Analyse: true, Env: PerSource()));
+                runs.Add(new("analyse persource hash existing 1M/3000k", "hash", 1_000 * K, 1_000 * K, Analyse: true, Env: PerSource()));
+                runs.Add(new("analyse global hash new-source 1M/750k", "hash", 1_000 * K, 250 * K, TargetSource: "new", Analyse: true));
+                runs.Add(new("analyse global hash existing 1M/750k", "hash", 1_000 * K, 250 * K, Analyse: true));
+                runs.Add(new("analyse persource obj first 2M/6000k d25", "obj", 2_000 * K, 2_000 * K, TargetSource: "new", Analyse: true, Env: PerSource(), Params: First25));
+                runs.Add(new("analyse persource objrescan 2M/6000k n1", "objrescan", 2_000 * K, 2_000 * K, Analyse: true, Env: PerSource(), Params: Rescan1));
+                break;
+            case "timing":      // clean per-source cells and the two objective acceptance cells (informational on a loaded machine)
+                for (var r = 1; r <= repeat; r++)
+                {
+                    runs.Add(new($"persource hash existing 1M/3000k r{r}", "hash", 1_000 * K, 1_000 * K, Env: PerSource()));
+                    runs.Add(new($"persource hash new-source 1M/3000k r{r}", "hash", 1_000 * K, 1_000 * K, TargetSource: "new", Env: PerSource()));
+                    runs.Add(new($"persource obj first 2M/6000k d25 r{r}", "obj", 2_000 * K, 2_000 * K, TargetSource: "new", Env: PerSource(), Params: First25));
+                    runs.Add(new($"persource objrescan 2M/6000k n1 r{r}", "objrescan", 2_000 * K, 2_000 * K, Env: PerSource(), Params: Rescan1));
+                }
+                break;
+            case "rollback":
+                runs.Add(new("cancel persource objrescan 2M/6000k n1", "objrescan", 2_000 * K, 2_000 * K, Mode: "cancel", Env: PerSource(), Params: Rescan1));
+                runs.Add(new("crash persource objrescan 2M/6000k n1", "objrescan", 2_000 * K, 2_000 * K, Mode: "crash", Env: PerSource(), Params: Rescan1));
+                runs.Add(new("cancel persource obj first 2M/6000k d25", "obj", 2_000 * K, 2_000 * K, TargetSource: "new", Mode: "cancel", Env: PerSource(), Params: First25));
+                break;
+            case "extra":       // single informational runs of a stress cell of each kind and the clean worst-case existing cell
+                runs.Add(new("persource obj first 2M/6000k d60 data", "obj", 2_000 * K, 2_000 * K, TargetSource: "new", Env: PerSource(), Params: First60));
+                runs.Add(new("persource objrescan 2M/6000k n10", "objrescan", 2_000 * K, 2_000 * K, Env: PerSource(), Params: Rescan10));
+                runs.Add(new("persource hash existing 2M/6000k", "hash", 2_000 * K, 2_000 * K, Env: PerSource()));
+                break;
+            case "smoke":
+                runs.Add(new("smoke persource obj first 100k/300k d25", "obj", 100 * K, 100 * K, TargetSource: "new", Analyse: true, Env: PerSource(), Params: First25));
+                runs.Add(new("smoke persource objrescan 100k/300k n1", "objrescan", 100 * K, 100 * K, Analyse: true, Env: PerSource(), Params: Rescan1));
+                runs.Add(new("smoke global hash existing 100k/300k", "hash", 100 * K, 100 * K, Analyse: true));
+                runs.Add(new("smoke cancel persource objrescan 100k/300k n1", "objrescan", 100 * K, 100 * K, Mode: "cancel", Env: PerSource(), Params: Rescan1));
+                runs.Add(new("smoke crash persource objrescan 100k/300k n1", "objrescan", 100 * K, 100 * K, Mode: "crash", Env: PerSource(), Params: Rescan1));
+                break;
+            default:
+                throw new ArgumentException("unknown repair plan " + name);
+        }
+        return runs;
+    }
