+/// <summary>Parses a rollback journal (sqlite.org/fileformat2.html §4) and attributes each journalled page to the B-tree that owned it
+/// in a copy of the database taken before the transaction began.</summary>
+internal static class JournalAnalysis
+{
+    private static readonly byte[] Magic = [0xd9, 0xd5, 0x05, 0xf9, 0x20, 0xa1, 0x63, 0xd7];
+
+    internal static string Analyse(string journalPath, string dbBeforePath)
+    {
+        var owners = PageOwnership.Map(dbBeforePath, out var pageSize, out var pageCount);
+        var bytes = File.ReadAllBytes(journalPath);
+        var pages = new HashSet<uint>();
+        long records = 0, segments = 0, synced = 0, sector = 0, dupes = 0;
+        long offset = 0;
+        // A segment's magic and record count are written only when the journal is synced (pager.c syncJournal, synchronous=FULL);
+        // the last, not yet synced segment has an all-zero magic and its records run to the end of the file.
+        while (offset + 28 <= bytes.Length)
+        {
+            var hasMagic = bytes.AsSpan((int)offset, 8).SequenceEqual(Magic);
+            if (!hasMagic && bytes.AsSpan((int)offset, 12).IndexOfAnyExcept((byte)0) >= 0) break;
+            segments++;
+            if (hasMagic) synced++;
+            var nRec = hasMagic ? BinaryPrimitives.ReadUInt32BigEndian(bytes.AsSpan((int)offset + 8)) : 0;
+            sector = BinaryPrimitives.ReadUInt32BigEndian(bytes.AsSpan((int)offset + 20));
+            var ps = BinaryPrimitives.ReadUInt32BigEndian(bytes.AsSpan((int)offset + 24));
+            var recordSize = ps + 8;
+            if (sector == 0) break;
+            var start = offset + sector;
+            var count = nRec == 0 || nRec == 0xFFFFFFFF ? (bytes.Length - start) / recordSize : nRec;
+            for (long r = 0; r < count; r++)
+            {
+                var at = start + r * recordSize;
+                if (at + recordSize > bytes.Length) break;
+                var pgno = BinaryPrimitives.ReadUInt32BigEndian(bytes.AsSpan((int)at));
+                if (!pages.Add(pgno)) dupes++;
+                records++;
+            }
+            var end = start + count * recordSize;
+            offset = (end + sector - 1) / sector * sector;
+            if (nRec == 0) break;
+        }
+        var byOwner = new Dictionary<string, (long Journalled, long Total)>();
+        foreach (var (pg, owner) in owners)
+        {
+            byOwner.TryGetValue(owner, out var v);
+            byOwner[owner] = (v.Journalled, v.Total + 1);
+        }
+        foreach (var pg in pages)
+        {
+            var owner = owners.TryGetValue(pg, out var o) ? o : pg > pageCount ? "(beyond original end)" : "(unknown)";
+            byOwner.TryGetValue(owner, out var v);
+            byOwner[owner] = (v.Journalled + 1, v.Total);
+        }
+        var sb = new StringBuilder();
+        sb.Append(CultureInfo.InvariantCulture, $"journal {bytes.Length} B, {segments} segment(s) ({synced} synced), sector {sector}, page {pageSize}, {records} records, {pages.Count} distinct pages ({dupes} repeats), {(double)bytes.Length / Math.Max(1, pages.Count):0} B per distinct page, original {pageCount} pages; journalled/total by B-tree: ");
+        sb.Append(string.Join(", ", byOwner.Where(kv => kv.Value.Journalled > 0 || kv.Value.Total > 200).OrderByDescending(kv => kv.Value.Journalled).ThenByDescending(kv => kv.Value.Total)
+            .Select(kv => $"{kv.Key} {kv.Value.Journalled}/{kv.Value.Total}")));
+        return sb.ToString();
+    }
+}
