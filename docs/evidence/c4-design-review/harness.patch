+    private static ImportResult Import(LibrarySession session, ISnapshotRowSource snapshot, string runId, ImportSourceSpec source, ImportOptions? options, CancellationToken cancellation, out double seconds)
+    {
+        var header = snapshot switch { DrSnapshot d => d.Header(runId), SyntheticSnapshot s => s.Header(runId), _ => throw new ArgumentException("row source") };
+        using var prepare = Lease(session, MutationKind.Prepare);
+        var attempt = session.RecordAttemptStartAsync(prepare, new AttemptStart(new byte[16], null, Utf16.ToBytes(@"D:\Media"), null, runId, DateTime.UtcNow.Ticks)).GetAwaiter().GetResult();
+        using var save = prepare.HandOffToObservation().HandOffToSave(out _);
+        var watch = Stopwatch.StartNew();
+        try
+        {
+            return session.ImportSnapshotAsync(save, attempt, source, header, snapshot, options, cancellation).GetAwaiter().GetResult();
+        }
+        finally
+        {
+            seconds = watch.Elapsed.TotalSeconds;
+        }
+    }
