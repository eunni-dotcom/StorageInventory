+    /// <summary>Builds (once) and returns a cached prefilled Library main file for this family and prefill size.</summary>
+    private static string? EnsurePrefill(string prefillRoot, RunSpec run, Action<string> log)
+    {
+        var persource = run.Env is not null && run.Env.ContainsKey("SI_DR_PERSOURCE") ? "-persource" : "";
+        var key = $"{PrefillFamily(run.Family)}-{run.Prefill}{persource}";
+        var dir = Path.Combine(prefillRoot, key);
+        var main = Path.Combine(dir, LibraryNames.MainFile);
+        if (File.Exists(main) && File.Exists(main + ".ok")) return main;
+        Directory.CreateDirectory(dir);
+        log($"  building prefill {key}");
+        var (code, json, lines) = RunChild(["--benchmark", "dr", "prefill", "--family", PrefillFamily(run.Family), "--prefill", run.Prefill.ToString(CultureInfo.InvariantCulture), "--out", main], run.Env);
+        foreach (var l in lines) log("    " + l);
+        if (code != 0) { log($"  prefill FAILED ({code})"); return null; }
+        File.WriteAllText(main + ".ok", json ?? "");
+        return main;
+    }
