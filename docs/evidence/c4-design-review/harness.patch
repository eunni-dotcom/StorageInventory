+/// <summary>A read-only walk of a SQLite database file's B-trees (sqlite.org/fileformat2.html): page number to owning object
+/// (table or index name from sqlite_schema, "freelist" or "sqlite_schema").</summary>
+internal static class PageOwnership
+{
+    internal static Dictionary<uint, string> Map(string path, out int pageSize, out long pageCount)
+    {
+        var file = File.ReadAllBytes(path);
+        var rawSize = BinaryPrimitives.ReadUInt16BigEndian(file.AsSpan(16));
+        pageSize = rawSize == 1 ? 65536 : rawSize;
+        var reserved = file[20];
+        var usable = pageSize - reserved;
+        pageCount = BinaryPrimitives.ReadUInt32BigEndian(file.AsSpan(28));
+        var owners = new Dictionary<uint, string>();
+        var ps = pageSize;
+        ReadOnlySpan<byte> Page(uint n) => file.AsSpan((int)((n - 1) * (long)ps), ps);
+
+        // freelist
+        var trunk = BinaryPrimitives.ReadUInt32BigEndian(file.AsSpan(32));
+        while (trunk != 0)
+        {
+            owners[trunk] = "freelist (trunk)";
+            var p = Page(trunk);
+            var leaves = BinaryPrimitives.ReadUInt32BigEndian(p[4..]);
+            for (var i = 0; i < leaves; i++) owners[BinaryPrimitives.ReadUInt32BigEndian(p[(8 + 4 * i)..])] = "freelist (leaf)";
+            trunk = BinaryPrimitives.ReadUInt32BigEndian(p);
+        }
+
+        // sqlite_schema rows: (type, name, tbl_name, rootpage, sql)
+        var roots = new List<(string Name, uint Root)> { ("sqlite_schema", 1) };
+        Walk(1, "sqlite_schema", collectSchema: true);
+        foreach (var (name, root) in roots.Skip(1).ToList()) Walk(root, name, collectSchema: false);
+        return owners;
+
+        void Walk(uint root, string name, bool collectSchema)
+        {
+            var stack = new Stack<uint>();
+            stack.Push(root);
+            while (stack.Count > 0)
+            {
+                var n = stack.Pop();
+                owners[n] = name;
+                var page = Page(n);
+                var h = n == 1 ? 100 : 0;
+                var type = page[h];
+                var cells = BinaryPrimitives.ReadUInt16BigEndian(page[(h + 3)..]);
+                var interior = type is 0x02 or 0x05;
+                var headerSize = interior ? 12 : 8;
+                if (interior) stack.Push(BinaryPrimitives.ReadUInt32BigEndian(page[(h + 8)..]));
+                for (var c = 0; c < cells; c++)
+                {
+                    var cellOffset = BinaryPrimitives.ReadUInt16BigEndian(page[(h + headerSize + 2 * c)..]);
+                    var cell = page[cellOffset..];
+                    var pos = 0;
+                    if (interior) { stack.Push(BinaryPrimitives.ReadUInt32BigEndian(cell)); pos = 4; }
+                    if (type == 0x05) continue;   // table interior: child + rowid, no payload
+                    var payload = (long)Varint(cell, ref pos);
+                    if (type == 0x0D) Varint(cell, ref pos);   // rowid
+                    var isTable = type == 0x0D;
+                    var x = isTable ? usable - 35 : (usable - 12) * 64 / 255 - 23;
+                    var m = (usable - 12) * 32 / 255 - 23;
+                    long local;
+                    if (payload <= x) local = payload;
+                    else { var kk = m + (payload - m) % (usable - 4); local = kk <= x ? kk : m; }
+                    if (collectSchema && type == 0x0D)
+                    {
+                        var rec = ReadPayload(cell[pos..], payload, local);
+                        var cols = Record(rec);
+                        if (cols.Count >= 4 && cols[3] is long rp && rp > 0 && cols[1] is string nm) roots.Add((nm, (uint)rp));
+                    }
+                    if (payload > local)
+                    {
+                        var ov = BinaryPrimitives.ReadUInt32BigEndian(cell[(int)(pos + local)..]);
+                        while (ov != 0) { owners[ov] = name + " (overflow)"; ov = BinaryPrimitives.ReadUInt32BigEndian(Page(ov)); }
+                    }
+                }
+            }
+
+            byte[] ReadPayload(ReadOnlySpan<byte> start, long payload, long local)
+            {
+                var result = new byte[payload];
+                start[..(int)local].CopyTo(result);
+                var have = (int)local;
+                if (payload > local)
+                {
+                    var ov = BinaryPrimitives.ReadUInt32BigEndian(start[(int)local..]);
+                    while (ov != 0 && have < payload)
+                    {
+                        var p = Page(ov);
+                        var take = (int)Math.Min(usable - 4, payload - have);
+                        p.Slice(4, take).CopyTo(result.AsSpan(have));
+                        have += take;
+                        ov = BinaryPrimitives.ReadUInt32BigEndian(p);
+                    }
+                }
+                return result;
+            }
+        }
+    }
+
+    private static ulong Varint(ReadOnlySpan<byte> s, ref int pos)
+    {
+        ulong v = 0;
+        for (var i = 0; i < 8; i++)
+        {
+            var b = s[pos++];
+            v = (v << 7) | (uint)(b & 0x7f);
+            if ((b & 0x80) == 0) return v;
+        }
+        return (v << 8) | s[pos++];
+    }
+
+    private static List<object?> Record(byte[] rec)
+    {
+        var pos = 0;
+        var headerLen = (int)Varint(rec, ref pos);
+        var types = new List<ulong>();
+        while (pos < headerLen) types.Add(Varint(rec, ref pos));
+        var cols = new List<object?>();
+        var at = headerLen;
+        foreach (var t in types)
+        {
+            switch (t)
+            {
+                case 0: cols.Add(null); break;
+                case 1: cols.Add((long)(sbyte)rec[at]); at += 1; break;
+                case 2: cols.Add((long)BinaryPrimitives.ReadInt16BigEndian(rec.AsSpan(at))); at += 2; break;
+                case 3: cols.Add((long)((rec[at] << 16 | rec[at + 1] << 8 | rec[at + 2]) << 8 >> 8)); at += 3; break;
+                case 4: cols.Add((long)BinaryPrimitives.ReadInt32BigEndian(rec.AsSpan(at))); at += 4; break;
+                case 5: { long v = 0; for (var i = 0; i < 6; i++) v = (v << 8) | rec[at + i]; cols.Add(v << 16 >> 16); at += 6; break; }
+                case 6: cols.Add(BinaryPrimitives.ReadInt64BigEndian(rec.AsSpan(at))); at += 8; break;
+                case 7: cols.Add(BitConverter.Int64BitsToDouble(BinaryPrimitives.ReadInt64BigEndian(rec.AsSpan(at)))); at += 8; break;
+                case 8: cols.Add(0L); break;
+                case 9: cols.Add(1L); break;
+                default:
+                    if (t >= 12 && t % 2 == 0) { var len = (int)(t - 12) / 2; cols.Add(rec.AsSpan(at, len).ToArray()); at += len; }
+                    else if (t >= 13) { var len = (int)(t - 13) / 2; cols.Add(Encoding.UTF8.GetString(rec, at, len)); at += len; }
+                    else cols.Add(null);
+                    break;
+            }
+        }
+        return cols;
+    }
+}
