+﻿using System.Globalization;
+
+namespace StorageInventory.Library;
+
+/// <summary>C4 DESIGN REVIEW PROBES ONLY (scratch build, never committed to src): environment-gated variants of the import.</summary>
+internal static class DrProbe
+{
+    internal static readonly bool PerSource = Environment.GetEnvironmentVariable("SI_DR_PERSOURCE") == "1";
+    internal static readonly bool Presort = Environment.GetEnvironmentVariable("SI_DR_PRESORT") == "1";
+    internal static readonly bool PresortChunk = Environment.GetEnvironmentVariable("SI_DR_PRESORT") == "chunk";
+    internal const int ChunkFiles = 262_144;
+    internal static int Chunks;
+    internal static readonly int CacheKib = int.TryParse(Environment.GetEnvironmentVariable("SI_DR_CACHE_KIB"), NumberStyles.Integer, CultureInfo.InvariantCulture, out var k) ? k : 0;
+    internal static readonly int BatchRows = int.TryParse(Environment.GetEnvironmentVariable("SI_DR_BATCH_ROWS"), NumberStyles.Integer, CultureInfo.InvariantCulture, out var b) ? b : 0;
+    internal static readonly int BatchFailAfter = int.TryParse(Environment.GetEnvironmentVariable("SI_DR_BATCH_FAIL_AFTER"), NumberStyles.Integer, CultureInfo.InvariantCulture, out var f) ? f : 0;
+    internal static string? JournalPath;
+    internal static int Batches;
+    internal static long JournalBytesTotal;
+    internal static long JournalMaxAtCommit;
+    internal static long PresortNames;
+    internal static double PresortSeconds;
+
+    internal static long JournalNow()
+    {
+        if (JournalPath is null) return 0;
+        try
+        {
+            using var fs = new FileStream(JournalPath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
+            return fs.Length;
+        }
+        catch (IOException) { return 0; }
+    }
+
+    internal static void SampleBeforeCommit()
+    {
+        var j = JournalNow();
+        JournalBytesTotal += j;
+        if (j > JournalMaxAtCommit) JournalMaxAtCommit = j;
+    }
+
+    internal static void EndBatch(WriterConnection writer, MutationLease lease)
+    {
+        SampleBeforeCommit();
+        writer.Commit(lease);
+        Batches++;
+        if (BatchFailAfter > 0 && Batches >= BatchFailAfter) throw new ImportException(CaptureFailureKind.LibraryIoError, $"probe: planted failure after {Batches} committed batches");
+        writer.Begin(lease);
+    }
+
+    internal static void Report()
+    {
+        var path = Environment.GetEnvironmentVariable("SI_DR_PROBE_REPORT");
+        if (path is null) return;
+        File.WriteAllText(path, string.Create(CultureInfo.InvariantCulture,
+            $"batches={Batches} journal_bytes_written_total={JournalBytesTotal} journal_max_at_a_commit={JournalMaxAtCommit} presort_names={PresortNames} presort_seconds={PresortSeconds:0.00} chunks={Chunks}"));
+    }
+}
